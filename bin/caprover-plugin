#!/bin/bash
set -e

# Script specifically made for CapRover to use in CI/CD workflows or with a template file
# Check .github/workflows/deploy for an example on how to CI/Cd
# Starts a plugin server

./bin/migrate-check

# Stop any background jobs on exit
trap 'kill $(jobs -p)' EXIT

./bin/plugin-server &

# Exit if any processes exit, and exit with it's exit code
wait -n
exit $?
